@page "/login"
@layout AuthLayout
@using ReforaTec.Models
@using ReforaTec.Services
@inject NavigationManager Nav
@inject IReforaTecApiService ApiService
@inject TokenService TokenService

@*
    ============================================================================
     PAGINA: Login  (Épica 1 - Autenticación por OTP)
    ----------------------------------------------------------------------------
     Ahora conectada a la API REAL: http://reforatec-api.onrender.com
       - Paso 1: envía el correo → POST /api/v1/otp-codes
       - Paso 2: verifica el OTP → POST /api/v1/sessions
       - Guarda los tokens JWT con TokenService
       - Redirige al home
    ============================================================================
*@

<div class="auth-card">

    <div class="auth-brand">
        <span class="auth-leaf">🌳</span>
        <h1>ReforaTec</h1>
    </div>
    <p class="auth-sub">Portal administrativo</p>

    @if (paso == Paso.Correo)
    {
        <label class="field-label">Correo institucional</label>
        <input class="input" type="email" @bind="correo"
               placeholder="usuario@@cdmadero.tecnm.mx" />

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="msg msg--error">@mensaje</p>
        }

        <button class="btn btn--primary btn--block" @onclick="EnviarCodigo" disabled="@cargando">
            @(cargando ? "Enviando..." : "Enviar código")
        </button>

        <p class="auth-hint">
            Usa tu correo institucional registrado en ReforaTec.
        </p>
    }
    else if (paso == Paso.Codigo)
    {
        <p class="auth-info">Enviamos un código de 6 dígitos a <b>@correo</b>.</p>

        <label class="field-label">Código de verificación</label>
        <input class="input input--code" maxlength="6" @bind="codigo" placeholder="######" />

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="msg msg--error">@mensaje</p>
        }

        <button class="btn btn--primary btn--block" @onclick="VerificarCodigo" disabled="@cargando">
            @(cargando ? "Verificando..." : "Entrar")
        </button>
        <button class="btn btn--ghost btn--block" @onclick="Volver" disabled="@cargando">
            Cambiar correo
        </button>
    }
</div>

@code {
    private enum Paso { Correo, Codigo }
    private Paso paso = Paso.Correo;

    private string correo = string.Empty;
    private string codigo = string.Empty;
    private string mensaje = string.Empty;
    private bool cargando = false;

    // ⚠️ Este es el "audience" que espera la API. Ajústalo según lo que te indique el equipo de la API.
    private const string Audience = "refortec-web";

    // ---- Paso 1: solicitar el OTP real a la API ----------------------------
    private async Task EnviarCodigo()
    {
        mensaje = string.Empty;

        if (string.IsNullOrWhiteSpace(correo) || !correo.Contains("@"))
        {
            mensaje = "Escribe un correo válido.";
            return;
        }

        cargando = true;
        try
        {
            await ApiService.RequestOtpAsync(new AuthRequestOtpRequest
            {
                Email = correo.Trim().ToLower()
            });

            paso = Paso.Codigo;
        }
        catch (HttpRequestException ex)
        {
            mensaje = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => "Correo inválido o no registrado.",
                System.Net.HttpStatusCode.NotFound => "El correo no está registrado en ReforaTec.",
                _ => $"Error al solicitar el código: {ex.Message}"
            };
        }
        catch (Exception ex)
        {
            mensaje = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    // ---- Paso 2: verificar el OTP y guardar los tokens ---------------------
    private async Task VerificarCodigo()
    {
        mensaje = string.Empty;

        if (codigo.Length != 6 || !codigo.All(char.IsDigit))
        {
            mensaje = "El código debe tener 6 dígitos.";
            return;
        }

        cargando = true;
        try
        {
            var response = await ApiService.VerifyOtpAsync(new AuthVerifyOtpRequest
            {
                Email = correo.Trim().ToLower(),
                OtpCode = codigo,
                Audience = Audience
            });

            // ✅ Guardar los tokens JWT
            await TokenService.SaveTokensAsync(response.AccessToken, response.RefreshToken);

            // ✅ Redirigir al home
            Nav.NavigateTo("/");
        }
        catch (HttpRequestException ex)
        {
            mensaje = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Código incorrecto o expirado.",
                System.Net.HttpStatusCode.BadRequest => "Datos inválidos. Revisa el código.",
                _ => $"Error al verificar el código: {ex.Message}"
            };
        }
        catch (Exception ex)
        {
            mensaje = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        paso = Paso.Correo;
        codigo = string.Empty;
        mensaje = string.Empty;
    }
}